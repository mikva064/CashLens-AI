CASHLENS_API_KEY=change-me
# mock — демо без модели; model — локальная Qwen (нужны веса и config/rules.json)
CASHLENS_ANALYZER=mock
CASHLENS_MODEL_DIR=local/models/qwen3-vl-2b
CASHLENS_RULES=config/rules.json
CASHLENS_JOB_TIMEOUT=270
CASHLENS_MAX_UPLOAD_MB=300
CASHLENS_WEB_UPLOAD=1
CASHLENS_MOCK_DELAY=2
