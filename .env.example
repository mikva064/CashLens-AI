CASHLENS_API_KEY=change-me
# model — настоящая локальная Qwen; mock включается только явно для тестов
CASHLENS_ANALYZER=model
CASHLENS_MODEL_DIR=local/models/qwen3-vl-2b
CASHLENS_RULES=config/rules.json
CASHLENS_OBSERVATIONS=config/observations.json
CASHLENS_JOB_TIMEOUT=270
# Отдельный предел начальной/повторной загрузки дочернего процесса модели.
CASHLENS_MODEL_LOAD_TIMEOUT=180
# Включает выполняемую задачу и очередь. Переполнение → сохранённый failed/queue_full.
CASHLENS_MAX_OUTSTANDING_JOBS=1
CASHLENS_MAX_UPLOAD_MB=300
CASHLENS_WEB_UPLOAD=1
CASHLENS_QUANTIZE_4BIT=1
# balanced: меньше пикселей и до 8 кадров на уточнение; quality: крупнее и до 12.
# Для смены профиля измените значение и перезапустите сервис.
CASHLENS_PERFORMANCE_PROFILE=balanced
# Доля времени вычислений с паузами, не жёсткий потолок мгновенной загрузки GPU.
CASHLENS_GPU_DUTY_CYCLE=0.65
# Бюджет аллокатора PyTorch; память драйвера и других приложений не включена.
CASHLENS_GPU_MEMORY_FRACTION=0.70
CASHLENS_SAMPLE_FPS=1
CASHLENS_WINDOW_SEC=24
CASHLENS_OVERLAP_SEC=4
CASHLENS_MAX_NEW_TOKENS=384
CASHLENS_MODEL_NAME=Qwen3-VL-2B-Instruct
# Порт публикации только для Docker; внутренний порт контейнера всегда 8000.
CASHLENS_PORT=8000
# Необязательные переопределения профиля:
# CASHLENS_MAX_EDGE=384
# CASHLENS_REFINE_MAX_EDGE=640
# CASHLENS_MAX_PIXELS=131072
# CASHLENS_MAX_REFINE_FRAMES=8
