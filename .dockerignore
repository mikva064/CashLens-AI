# Send only application source and public rules to the builder.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!README.md
!src/
!src/**
!analyzer/
!analyzer/**
!app/
!app/**
!web/
!web/**
!config/
!config/rules.json

# Keep these exclusions even if more source directories are allowed above.
local/
data/
datasets/
videos/
models/
weights/
work/
runs/
artifacts/
reports/
**/.git
**/.git/**
**/.env
**/.env.*
**/.venv
**/.venv/**
**/__pycache__
**/__pycache__/**
**/*.pyc
**/*.pyo
**/*.mov
**/*.mp4
**/*.avi
**/*.mkv
**/*.xlsx
**/*.jpg
**/*.jpeg
**/*.png
**/*.safetensors
**/*.bin
**/*.gguf
**/*.pt
**/*.pth
